{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Forensic knowledge file",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KnowledgeEntry"
      }
    }
  },
  "$defs": {
    "BeliefTest": {
      "additionalProperties": false,
      "description": "How a belief (knowledge from experience) is checked against runs. ``config_effect``: changing a config key\nmoves a metric; ``loss_behaviour``: a loss family behaves a certain way. ``scope`` is a run search query.",
      "properties": {
        "type": {
          "default": "config_effect",
          "enum": [
            "config_effect",
            "loss_behaviour"
          ],
          "title": "Type",
          "type": "string"
        },
        "key": {
          "default": "",
          "description": "config_effect: flattened config key, suffix match (e.g. optimizer.lr)",
          "title": "Key",
          "type": "string"
        },
        "change": {
          "default": "increase",
          "enum": [
            "increase",
            "decrease",
            "set"
          ],
          "title": "Change",
          "type": "string"
        },
        "value": {
          "default": "",
          "description": "config_effect with change=set: the value the key is set to",
          "title": "Value",
          "type": "string"
        },
        "metric": {
          "default": "",
          "description": "config_effect: metric key as logged (e.g. val/score[class=combined_metric])",
          "title": "Metric",
          "type": "string"
        },
        "expect": {
          "default": "up",
          "enum": [
            "up",
            "down",
            "no_change"
          ],
          "title": "Expect",
          "type": "string"
        },
        "min_effect": {
          "default": 0.01,
          "description": "relative change that counts as an effect",
          "maximum": 1,
          "minimum": 0,
          "title": "Min Effect",
          "type": "number"
        },
        "family": {
          "default": "",
          "description": "loss_behaviour: loss family (radar, camera, decoder_bbox\u2026) or term glob",
          "title": "Family",
          "type": "string"
        },
        "behaviour": {
          "default": "muted",
          "enum": [
            "muted",
            "trusted",
            "plateaus_early",
            "still_learning",
            "rising"
          ],
          "title": "Behaviour",
          "type": "string"
        },
        "scope": {
          "default": "",
          "description": "run search query the belief is about; empty = the newest runs",
          "title": "Scope",
          "type": "string"
        },
        "max_runs": {
          "default": 40,
          "maximum": 200,
          "minimum": 2,
          "title": "Max Runs",
          "type": "integer"
        }
      },
      "title": "BeliefTest",
      "type": "object"
    },
    "Effects": {
      "additionalProperties": false,
      "properties": {
        "ignore_metrics": {
          "description": "metric globs set aside (canonical key or name, e.g. '*velocity*')",
          "items": {
            "type": "string"
          },
          "title": "Ignore Metrics",
          "type": "array"
        },
        "ignore_classes": {
          "description": "classes set aside (case-insensitive)",
          "items": {
            "type": "string"
          },
          "title": "Ignore Classes",
          "type": "array"
        },
        "caveat": {
          "default": "",
          "description": "shown wherever this entry applies",
          "title": "Caveat",
          "type": "string"
        },
        "setup": {
          "default": "",
          "description": "setup label this entry assigns (kind: setup)",
          "title": "Setup",
          "type": "string"
        }
      },
      "title": "Effects",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "",
          "title": "By",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "code_refs": {
          "description": "file:line references in the training codebase",
          "items": {
            "type": "string"
          },
          "title": "Code Refs",
          "type": "array"
        },
        "via": {
          "default": "",
          "description": "how it got here: ui, harness:<task>, import",
          "title": "Via",
          "type": "string"
        }
      },
      "title": "Source",
      "type": "object"
    },
    "When": {
      "additionalProperties": false,
      "description": "All given conditions must hold; an empty ``when`` always applies. Matching is case-insensitive.",
      "properties": {
        "setup": {
          "description": "any of these setup labels (e.g. 1v5r, 5v1L)",
          "items": {
            "type": "string"
          },
          "title": "Setup",
          "type": "array"
        },
        "dataset_contains": {
          "description": "any substring of a dataset name",
          "items": {
            "type": "string"
          },
          "title": "Dataset Contains",
          "type": "array"
        },
        "stage_contains": {
          "description": "any substring of the stage / run name",
          "items": {
            "type": "string"
          },
          "title": "Stage Contains",
          "type": "array"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "flattened config key glob \u2192 value glob; every pair must match some key",
          "title": "Config",
          "type": "object"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "run tag \u2192 value glob",
          "title": "Tags",
          "type": "object"
        }
      },
      "title": "When",
      "type": "object"
    },
    "KnowledgeEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "stable id, e.g. K-manual-labels-no-velocity",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "fact",
          "enum": [
            "constraint",
            "fact",
            "setup",
            "caveat",
            "code_ref",
            "belief"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "minLength": 3,
          "title": "Statement",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/When"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "proposed",
            "active",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "test": {
          "anyOf": [
            {
              "$ref": "#/$defs/BeliefTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "kind belief: how to check it against runs"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "KnowledgeEntry",
      "type": "object"
    }
  }
}
