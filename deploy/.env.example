# Copy to .env next to docker-compose.yml (git-ignored). Secrets live here or in your secret store — never in git.
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_CLIENT_ID=<app-registration-client-id>
ENTRA_CLIENT_SECRET=<client-secret>
OAUTH2_PROXY_COOKIE_SECRET=<32-byte-base64>   # python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MF_TEAMS_WEBHOOK=<https://….webhook.office.com/…>
AZURE_CLIENT_ID=<managed-identity-client-id>
